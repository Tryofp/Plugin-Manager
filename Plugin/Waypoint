-- SCP RADAR
--==================================================
updateRadarGuiContent = function()
    if not radarScrollContainer then return end
    for _, child in ipairs(radarScrollContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local list, dedupe = {}, {}
    for part, data in pairs(streamingCache) do
        if part and part.Parent and isBasePart(part) then
            local pos = part.Position
            if not isPositionSaved(pos) then
                local dedupeKey = tostring(data.key) .. "_" ..
                    math.floor(pos.X / 3) .. "_" .. math.floor(pos.Z / 3)
                local previous = dedupe[dedupeKey]
                if not previous or (data.priorityScore or 0) > (previous.priorityScore or 0) then
                    dedupe[dedupeKey] = data
                end
            end
        end
    end
    for _, data in pairs(dedupe) do table.insert(list, data) end

    table.sort(list, function(a, b)
        local na, nb = tonumber(a.key), tonumber(b.key)
        if na and nb then return na < nb end
        if na then return true end
        if nb then return false end
        return tostring(a.key) < tostring(b.key)
    end)

    local y = 0
    for _, data in ipairs(list) do
        local label = tonumber(data.key) and ("CP " .. tostring(data.key)) or tostring(data.key)
        local row = makeListRow(radarScrollContainer, y, label, tostring(data.desc), true)

        local tele = Instance.new("TextButton")
        tele.Size = UDim2.new(0, 45, 0, 20)
        tele.Position = UDim2.new(1, -50, 0, 4)
        tele.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
        tele.Text = "TELE"
        tele.TextColor3 = Color3.new(1, 1, 1)
        tele.Font = Enum.Font.SourceSansBold
        tele.TextSize = 11
        tele.Parent = row
        addCorner(tele, 4)

        tele.MouseButton1Click:Connect(function()
            if data.part and data.part.Parent then
                local cf = data.part.CFrame
                safeTeleport(cf)
                addOrUpdateSavedCP(data.key, data.desc, cf)
                notify("TeleportCP", "Teleport berhasil dan CP disimpan.", 1.5)
            end
        end)
        y = y + 32
    end
    radarScrollContainer.CanvasSize = UDim2.new(0, 0, 0, y)
end

local function createSCPWindow()
    if radarGui then
        radarGui.Enabled = not radarGui.Enabled
        if radarGui.Enabled then updateRadarGuiContent() end
        return
    end

    local gui, main, header, scroll = makeWindow(
        "TeleportCP_SCP_Window", "Streaming Radar (SCP)", UDim2.new(0.5, -140, 0.3, 0)
    )
    radarGui, radarMainFrame, radarScrollContainer = gui, main, scroll

    local refresh = makeHeaderButton(header, "R", -78, Color3.fromRGB(40, 120, 180))
    local minimize = makeHeaderButton(header, "-", -52, Color3.fromRGB(45, 52, 65))
    local close = makeHeaderButton(header, "X", -26, Color3.fromRGB(200, 50, 60))

    refresh.MouseButton1Click:Connect(function()
        task.spawn(function()
            local descendants = Workspace:GetDescendants()
            for i, obj in ipairs(descendants) do
                pcall(processAndHookPart, obj)
                if i % 60 == 0 then task.wait() end
            end
            updateRadarGuiContent()
            notify("SCP Radar", "Pemindaian ulang selesai.", 1.5)
        end)
    end)

    minimize.MouseButton1Click:Connect(function()
        isRadarMinimized = not isRadarMinimized
        main.Size = isRadarMinimized and UDim2.new(0, 280, 0, 32) or UDim2.new(0, 280, 0, 240)
        scroll.Visible = not isRadarMinimized
    end)
    close.MouseButton1Click:Connect(function() gui.Enabled = false end)
    updateRadarGuiContent()
end

