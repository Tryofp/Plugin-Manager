local function notify(title, message, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = message,
            Duration = duration or 2
        })
    end)
end

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function safeTeleport(targetCF)
    local hrp = getHRP()
    if not hrp or typeof(targetCF) ~= "CFrame" then return end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = targetCF + Vector3.new(0, HEIGHT_OFFSET, 0)
end

--==================================================
-- JSON PERSISTENCE + VISITED KEYS
--==================================================
local function positionKey(key, pos)
    return tostring(key) .. "_" .. math.floor(pos.X) .. "_" ..
        math.floor(pos.Y) .. "_" .. math.floor(pos.Z)
end

local function isPositionSaved(pos)
    for _, item in ipairs(savedCheckpointsList) do
        if item.cf then
            local ok, itemCF = pcall(function()
                return CFrame.new(unpack(item.cf))
            end)
            if ok and (itemCF.Position - pos).Magnitude < 3 then
                return true
            end
        end
    end
    return false
end

local function saveCheckpointsToFile()
    if not (writefile and readfile) then return end
    pcall(function()
        local masterData = {}
        if isfile and isfile(MASTER_FILE_NAME) then
            local decoded = HttpService:JSONDecode(readfile(MASTER_FILE_NAME))
            if type(decoded) == "table" then masterData = decoded end
        end
        masterData[CURRENT_MAP_KEY] = savedCheckpointsList
        writefile(MASTER_FILE_NAME, HttpService:JSONEncode(masterData))
    end)
end

local function loadSavedCheckpoints()
    savedCheckpointsList = {}
    visitedKeys = {}
    if not (readfile and isfile) then return end

    pcall(function()
        if not isfile(MASTER_FILE_NAME) then return end
        local decoded = HttpService:JSONDecode(readfile(MASTER_FILE_NAME))
        if type(decoded) ~= "table" then return end

        local mapData = decoded[CURRENT_MAP_KEY]
        if type(mapData) ~= "table" then return end

        for _, item in ipairs(mapData) do
            if type(item) == "table" and item.key ~= nil and type(item.cf) == "table" then
                local ok, cf = pcall(function()
                    return CFrame.new(unpack(item.cf))
                end)
                if ok then
                    table.insert(savedCheckpointsList, item)
                    visitedKeys[positionKey(item.key, cf.Position)] = true
                    visitedKeys[tostring(item.key) .. "_saved"] = true
                end
            end
        end
    end)
end

loadSavedCheckpoints()

local function addOrUpdateSavedCP(key, desc, cf)
    if typeof(cf) ~= "CFrame" then return end
    local pos = cf.Position
    local serializedCF = {cf:GetComponents()}
    visitedKeys[positionKey(key, pos)] = true

    for _, item in ipairs(savedCheckpointsList) do
        if item.cf then
            local ok, oldCF = pcall(function()
                return CFrame.new(unpack(item.cf))
            end)
            if ok and (oldCF.Position - pos).Magnitude < 3 then
                item.key = key
                item.desc = desc
                item.cf = serializedCF
                saveCheckpointsToFile()
                if updateCpnGuiContent then updateCpnGuiContent() end
                if updateRadarGuiContent then updateRadarGuiContent() end
                return
            end
        end
    end

    table.insert(savedCheckpointsList, {key = key, desc = desc, cf = serializedCF})
    table.sort(savedCheckpointsList, function(a, b)
        local na, nb = tonumber(a.key), tonumber(b.key)
        if na and nb then return na < nb end
        if na then return true end
        if nb then return false end
        return tostring(a.key) < tostring(b.key)
    end)

    saveCheckpointsToFile()
    if updateCpnGuiContent then updateCpnGuiContent() end
    if updateRadarGuiContent then updateRadarGuiContent() end
    notify("Auto-Save CP", "Checkpoint tersimpan: " .. tostring(key), 2)
end

--==================================================
-- UNIVERSAL CHECKPOINT IDENTIFICATION
--==================================================
local function isBasePart(obj)
    return obj and obj:IsA("BasePart")
end

local function containsIgnoreWord(value)
    local lower = string.lower(tostring(value or ""))
    for _, word in ipairs(IGNORE_KEYWORDS) do
        if string.find(lower, word, 1, true) then
            return true
        end
    end
    return false
end

local function getInstancePath(obj)
    local names, current, depth = {}, obj, 0
    while current and current ~= Workspace and depth < 7 do
        table.insert(names, 1, current.Name)
        current = current.Parent
        depth = depth + 1
    end
    return table.concat(names, ".")
end

local function getPartFromObject(obj)
    if not obj then return nil end
    if isBasePart(obj) then return obj end
    if obj:IsA("Model") then
        if obj.PrimaryPart and isBasePart(obj.PrimaryPart) then
            return obj.PrimaryPart
        end
        return obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function collectText(root, output)
    if not root then return end
    for _, item in ipairs(root:GetDescendants()) do
        if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
            local txt = tostring(item.Text or "")
            if txt ~= "" then table.insert(output, txt) end
        end
    end
end

local function getIdentityText(obj, part)
    local names = {}
    local current = obj
    local depth = 0

    -- Name context from the object and its ancestors catches Model > Base/Part layouts.
    while current and current ~= Workspace and depth < 6 do
        table.insert(names, current.Name)
        current = current.Parent
        depth = depth + 1
    end

    if part and part ~= obj then table.insert(names, part.Name) end

    local guiTexts = {}
    if obj then collectText(obj, guiTexts) end
    if part and part ~= obj then collectText(part, guiTexts) end

    return string.lower(table.concat(names, " ")),
        string.lower(table.concat(guiTexts, " "))
end

local function hasCheckpointToken(text)
    text = string.lower(text or "")
    -- Use token boundaries so "cup", "sculpture", etc. do not match "cp".
    return string.find(text, "checkpoint", 1, true) ~= nil
        or string.find(text, "cekpoin", 1, true) ~= nil
        or string.find(text, "waypoint", 1, true) ~= nil
        or string.find(text, "summit", 1, true) ~= nil
        or string.find(text, "puncak", 1, true) ~= nil
        or string.find(text, "finish", 1, true) ~= nil
        or string.find(text, "peak", 1, true) ~= nil
        or string.find(text, "stage", 1, true) ~= nil
        or string.find(text, "ring", 1, true) ~= nil
        or string.find(text, "%f[%w]cp%f[%W]") ~= nil
        or string.find(text, "%f[%w]wp%f[%W]") ~= nil
end

local function extractCheckpointNumber(text)
    text = string.lower(text or "")
    local patterns = {
        "checkpoint[%s_%-]*(%d+)",
        "cekpoin[%s_%-]*(%d+)",
        "waypoint[%s_%-]*(%d+)",
        "stage[%s_%-]*(%d+)",
        "ring[%s_%-]*(%d+)",
        "%f[%w]cp[%s_%-]*(%d+)",
        "%f[%w]wp[%s_%-]*(%d+)",
        "%f[%w]pos[%s_%-]*(%d+)"
    }
    for _, pattern in ipairs(patterns) do
        local number = string.match(text, pattern)
        if number then return tonumber(number) end
    end
    return nil
end

local function findRouteContext(obj)
    local current = obj
    local depth = 0
    while current and current ~= Workspace and depth < 7 do
        local n = string.lower(current.Name)
        if string.find(n, "gunung", 1, true)
            or string.find(n, "jalur", 1, true)
            or string.find(n, "track", 1, true)
            or string.find(n, "route", 1, true)
            or string.find(n, "checkpoint", 1, true)
            or string.find(n, "waypoint", 1, true)
            or string.find(n, "stage", 1, true) then
            return current.Name
        end
        current = current.Parent
        depth = depth + 1
    end
    return nil
end

local function parseCPIdentity(obj)
    local part = getPartFromObject(obj)
    if not part or not part:IsDescendantOf(Workspace) then
        return nil, nil, nil, 0
    end

    local nameText, guiText = getIdentityText(obj, part)
    local combined = nameText .. " " .. guiText

    -- Do not reject a checkpoint just because its physical child is named "Base".
    -- Ignore filtering is applied to the full identity only when there is no CP signal.
    local explicit = hasCheckpointToken(nameText) or hasCheckpointToken(guiText)
    local routeContext = findRouteContext(obj) or findRouteContext(part)

    if not explicit then
        -- Plain numbered parts are accepted only inside a clearly named route/checkpoint folder.
        local plainNumber = string.match(string.lower(obj.Name), "^(%d+)$")
        if plainNumber and routeContext then
            explicit = true
        else
            return nil, nil, nil, 0
        end
    end

    if not explicit or (containsIgnoreWord(obj.Name) and not hasCheckpointToken(obj.Name)) then
        return nil, nil, nil, 0
    end

    -- Summit/finish labels receive a stable special key.
    if string.find(combined, "summit", 1, true)
        or string.find(combined, "puncak", 1, true)
        or string.find(combined, "finish", 1, true)
        or string.find(combined, "peak", 1, true) then
        local desc = routeContext and (routeContext .. " - Summit") or "SUMMIT"
        return "SUMMIT", desc, part, 10
    end

    local number = extractCheckpointNumber(combined)
    if not number then
        number = tonumber(string.match(string.lower(obj.Name), "^(%d+)$"))
    end

    if number and (number < 0 or number > 500) then
        return nil, nil, nil, 0
    end

    local key
    if number then
        key = number
    else
        -- Stable positional fallback; unlike a random counter it survives rejoin.
        local p = part.Position
        key = "AUTO_" .. math.floor(p.X / 3) .. "_" ..
            math.floor(p.Y / 3) .. "_" .. math.floor(p.Z / 3)
    end

    local desc
    if guiText ~= "" then
        desc = guiText
    elseif routeContext then
        desc = routeContext .. " - " .. tostring(obj.Name)
    else
        desc = tostring(obj.Name)
    end

    local score = number and 3 or 1
    if string.find(combined, "checkpoint", 1, true)
        or string.find(combined, "waypoint", 1, true)
        or string.find(combined, "stage", 1, true) then
        score = 4
    end

    return key, desc, part, score
end

--==================================================
-- EVENT-DRIVEN SCANNER + AUTOSAVE
--==================================================
local function processAndHookPart(obj)
    if not obj or not (obj:IsA("BasePart") or obj:IsA("Model")) then return end

    local cpKey, partDesc, realPart, priority = parseCPIdentity(obj)
    if not cpKey or not realPart then return end

    -- A part is connected once, even if both its Model and Part are discovered.
    local cacheKey = realPart
    local existing = streamingCache[cacheKey]
    if existing then
        if (priority or 0) > (existing.priorityScore or 0) then
            existing.key = cpKey
            existing.desc = partDesc
            existing.priorityScore = priority
        end
        return
    end

    local data = {
        key = cpKey,
        desc = partDesc,
        part = realPart,
        cf = realPart.CFrame,
        priorityScore = priority or 1
    }
    streamingCache[cacheKey] = data
    if updateRadarGuiContent then updateRadarGuiContent() end

    if hookedParts[realPart] then return end
    hookedParts[realPart] = true

    local lastTouch = 0
    realPart.Touched:Connect(function(hit)
        local now = os.clock()
        if now - lastTouch < 1 then return end
        local char = LocalPlayer.Character
        if not char or not hit or not hit:IsDescendantOf(char) then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        lastTouch = now
        if realPart.Parent then
            addOrUpdateSavedCP(cpKey, partDesc, realPart.CFrame)
        end
    end)

    local prompt = realPart:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then
        local model = realPart:FindFirstAncestorOfClass("Model")
        if model then prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true) end
    end

    if prompt then
        prompt.Triggered:Connect(function(playerWhoTriggered)
            if playerWhoTriggered == LocalPlayer and realPart.Parent then
                addOrUpdateSavedCP(cpKey, partDesc, realPart.CFrame)
            end
        end)
    end
end

local function scanObjectAndAncestors(obj)
    local current = obj
    local depth = 0
    while current and current ~= Workspace and depth < 5 do
        if current:IsA("BasePart") or current:IsA("Model") then
            pcall(processAndHookPart, current)
        end
        current = current.Parent
        depth = depth + 1
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    task.delay(0.25, function()
        if obj and obj.Parent then
            pcall(scanObjectAndAncestors, obj)
        end
    end)
end)

task.spawn(function()
    local descendants = Workspace:GetDescendants()
    for index, obj in ipairs(descendants) do
        pcall(processAndHookPart, obj)
        if index % 60 == 0 then task.wait() end
    end
end)

