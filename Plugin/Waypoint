updateCpnGuiContent = function()
    if not cpnScrollContainer then return end
    for _, child in ipairs(cpnScrollContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local y = 0
    for index, data in ipairs(savedCheckpointsList) do
        local simple = data.key == "" or data.key == "CP+"
        local left = simple and tostring(data.desc) or
            (tonumber(data.key) and ("CP " .. tostring(data.key)) or tostring(data.key))
        local row = makeListRow(cpnScrollContainer, y, left, tostring(data.desc), not simple)

        local tele = Instance.new("TextButton")
        tele.Size = UDim2.new(0, 38, 0, 20)
        tele.Position = UDim2.new(1, -88, 0, 4)
        tele.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
        tele.Text = "TELE"
        tele.TextColor3 = Color3.new(1, 1, 1)
        tele.Font = Enum.Font.SourceSansBold
        tele.TextSize = 10
        tele.Parent = row
        addCorner(tele, 4)

        tele.MouseButton1Click:Connect(function()
            if data.cf then
                local ok, cf = pcall(function() return CFrame.new(unpack(data.cf)) end)
                if ok then
                    safeTeleport(cf)
                    notify("CPN Manager", "Teleport ke saved CP berhasil!", 1.5)
                end
            end
        end)

        local del = Instance.new("TextButton")
        del.Size = UDim2.new(0, 38, 0, 20)
        del.Position = UDim2.new(1, -46, 0, 4)
        del.BackgroundColor3 = Color3.fromRGB(200, 50, 60)
        del.Text = "DEL"
        del.TextColor3 = Color3.new(1, 1, 1)
        del.Font = Enum.Font.SourceSansBold
        del.TextSize = 10
        del.Parent = row
        addCorner(del, 4)

        del.MouseButton1Click:Connect(function()
            local removed = table.remove(savedCheckpointsList, index)
            if removed and removed.cf then
                local ok, cf = pcall(function() return CFrame.new(unpack(removed.cf)) end)
                if ok then visitedKeys[positionKey(removed.key, cf.Position)] = nil end
            end
            saveCheckpointsToFile()
            updateCpnGuiContent()
            if updateRadarGuiContent then updateRadarGuiContent() end
            notify("CPN Manager", "Saved CP dihapus.", 1.5)
        end)
        y = y + 32
    end
    cpnScrollContainer.CanvasSize = UDim2.new(0, 0, 0, y)
end

local function createCPNWindow()
    if cpnGui then
        cpnGui.Enabled = not cpnGui.Enabled
        if cpnGui.Enabled then updateCpnGuiContent() end
        return
    end

    local gui, main, header, scroll = makeWindow(
        "TeleportCP_CPN_Window", "Waypoint Manager (CPN)", UDim2.new(0.5, 10, 0.3, 0)
    )
    cpnGui, cpnMainFrame, cpnScrollContainer = gui, main, scroll

    local plus = makeHeaderButton(header, "+", -78, Color3.fromRGB(0, 170, 100))
    local minimize = makeHeaderButton(header, "-", -52, Color3.fromRGB(45, 52, 65))
    local close = makeHeaderButton(header, "X", -26, Color3.fromRGB(200, 50, 60))

    plus.MouseButton1Click:Connect(function()
        local hrp = getHRP()
        if not hrp then
            notify("CPN Manager", "HumanoidRootPart tidak ditemukan!", 2)
            return
        end

        local nearest, nearestDistance = nil, 12
        for _, data in pairs(streamingCache) do
            if data.part and data.part.Parent then
                local distance = (data.part.Position - hrp.Position).Magnitude
                if distance <= nearestDistance then
                    nearest = data
                    nearestDistance = distance
                end
            end
        end

        if nearest then
            addOrUpdateSavedCP(nearest.key, nearest.desc, nearest.part.CFrame)
        else
            showCustomNamePrompt(function(customText)
                addOrUpdateSavedCP("", customText, hrp.CFrame)
            end)
        end
    end)

    minimize.MouseButton1Click:Connect(function()
        isCpnMinimized = not isCpnMinimized
        main.Size = isCpnMinimized and UDim2.new(0, 280, 0, 32) or UDim2.new(0, 280, 0, 240)
        scroll.Visible = not isCpnMinimized
    end)
    close.MouseButton1Click:Connect(function() gui.Enabled = false end)
    updateCpnGuiContent()
end

