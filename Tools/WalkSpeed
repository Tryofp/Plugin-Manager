local plugin = {
    ["PluginName"] = "walkspeed_aggressive";
    ["PluginDescription"] = "WalkSpeed agresif yang mempertahankan animasi lari natural.";
    ["Commands"] = {
        ["ws"] = {
            ["ListName"] = "ws [number]",
            ["Description"] = "Mengubah WalkSpeed asli dengan animasi normal.",
            ["Aliases"] = {"speed", "walkspeed"},
            ["Function"] = function(args, speaker)
                local speedValue = tonumber(args[1])
                if not speedValue then
                    warn("[WalkSpeed] Masukkan angka kecepatan yang valid! Contoh: ws 50")
                    return
                end

                _G.TargetWalkSpeed = speedValue
                _G.ActiveAggressiveWS = true

                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer

                -- Ganti koneksi/frame-loop lama dengan satu worker ringan.
                -- Beberapa game menimpa WalkSpeed setelah frame berjalan;
                -- loop task.wait() mengatur ulang nilainya secara berkala seperti loopws.
                if _G.AggressiveWSConnection then
                    pcall(function() _G.AggressiveWSConnection:Disconnect() end)
                    _G.AggressiveWSConnection = nil
                end

                _G.AggressiveWSToken = (_G.AggressiveWSToken or 0) + 1
                local myToken = _G.AggressiveWSToken

                task.spawn(function()
                    while _G.ActiveAggressiveWS and _G.AggressiveWSToken == myToken do
                        local char = localPlayer.Character
                        if char then
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Parent and hum.WalkSpeed ~= _G.TargetWalkSpeed then
                                pcall(function()
                                    hum.WalkSpeed = _G.TargetWalkSpeed
                                end)
                            end
                        end
                        task.wait()
                    end
                end)
                print("[WalkSpeed] Loop aktif dengan speed:", speedValue)
            end
        },
        ["unws"] = {
            ["ListName"] = "unws",
            ["Description"] = "Mematikan walkspeed agresif.",
            ["Aliases"] = {"unwalkspeed", "resetws"},
            ["Function"] = function(args, speaker)
                _G.ActiveAggressiveWS = false
                _G.AggressiveWSToken = (_G.AggressiveWSToken or 0) + 1
                if _G.AggressiveWSConnection then
                    pcall(function() _G.AggressiveWSConnection:Disconnect() end)
                    _G.AggressiveWSConnection = nil
                end
                
                local char = speaker.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = 16
                    end
                end
                print("[WalkSpeed] Dinonaktifkan!")
            end
        }
    }
}

return plugin
