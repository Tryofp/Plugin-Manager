-- Plugin Manager - Infinite Yield bootstrap plugin
-- Load this file with Infinite Yield's ;addplugin command.
-- The hub itself is launched directly from Main.lua on the public main branch.

local MAIN_URL =
    "https://raw.githubusercontent.com/Tryofp/Plugin-Manager/refs/heads/beta/Main.lua"

local Plugin = {
    ["PluginName"] = "Plugin Manager",
    ["PluginDescription"] = "Membuka Plugin Manager Hub dari Main.lua branch beta.",
    ["Commands"] = {
        ["hub"] = {
            ["ListName"] = "hub / masterhub",
            ["Description"] = "Membuka Plugin Manager Hub versi publik.",
            ["Aliases"] = {"masterhub"},
            ["Function"] = function(args, speaker)
                local success, err = pcall(function()
                    local source = game:HttpGet(MAIN_URL)
                    if type(source) ~= "string" or source == "" then
                        error("Main.lua kosong atau gagal diunduh.")
                    end

                    local chunk, compileError = loadstring(source, "PluginManager/Main.lua")
                    if type(chunk) ~= "function" then
                        error("Gagal compile Main.lua: " .. tostring(compileError))
                    end

                    chunk()
                end)

                if not success then
                    warn("[Plugin Manager] Gagal menjalankan Main.lua: " .. tostring(err))
                end
            end
        }
    }
}

return Plugin
