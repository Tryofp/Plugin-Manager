-- Plugin Manager - Infinite Yield bootstrap plugin
-- Load this file with Infinite Yield's ;addplugin command.
-- The actual plugin definition and hub command are maintained in Stable.lua.

local STABLE_PLUGIN_URL =
    "https://raw.githubusercontent.com/Tryofp/Plugin-Manager/refs/heads/stable/Stable.lua"

local success, result = pcall(function()
    local source = game:HttpGet(STABLE_PLUGIN_URL)
    if type(source) ~= "string" or source == "" then
        error("Stable.lua kosong atau gagal diunduh.")
    end

    local chunk, compileError = loadstring(source, "PluginManager/Stable.lua")
    if type(chunk) ~= "function" then
        error("Gagal compile Stable.lua: " .. tostring(compileError))
    end

    local plugin = chunk()
    if type(plugin) ~= "table" then
        error("Stable.lua tidak mengembalikan plugin table.")
    end

    if type(plugin.Commands) ~= "table"
        or type(plugin.Commands.hub) ~= "table"
        or type(plugin.Commands.hub.Function) ~= "function" then
        error("Command hub tidak ditemukan di Stable.lua.")
    end

    return plugin
end)

if not success then
    warn("[Plugin Manager] Gagal memuat Stable.lua: " .. tostring(result))
    error(result)
end

return result
